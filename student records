def find_invalid_records( 
    student_id,name,age,program,level,courses
    ):
    constraints= {
     'student_id': isinstance(student_id,str) and re.fullmatch( 'ST\d+',student_id,re.IGNORECASE),
     'name': isinstance(name,str),
     'age': isinstance(age,int) and age>=16,
     'program': isinstance(program,str),
     'level': level in [100,200,300,400],
     'courses': isinstance(courses,list) and all([isinstance(course,str) for course in courses])      
          }
    return [key for key,value in constraints.items() if not value]

